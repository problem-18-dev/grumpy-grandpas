		},
		{
			"uuid": "fb2bb30a-987e-41e0-8f7f-1fb6367d0f9d",
			"title": "[Feat] Chest collectible",
			"description": "A chest unlocks a weapon that hasn't been unlocked yet.\nRocker launcher is always available.",
			"category": "d6502c35-261e-4a08-ba5e-1e9c184e213f",
