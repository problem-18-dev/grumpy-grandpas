		},
		{
			"uuid": "033b469a-886c-4aaf-b345-1aa28f0bec93",
			"title": "[Feat] Dynamic camera",
			"description": "",
			"category": "d6502c35-261e-4a08-ba5e-1e9c184e213f",
			"steps": [
				{
					"details": "Follows player when valid",
					"done": false
				},
				{
